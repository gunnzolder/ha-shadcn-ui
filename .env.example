# Copy to .env.local (gitignored). Used by `pnpm dev:live`, `pnpm snapshot`, `pnpm deploy:ha`.

# Home Assistant URL reachable from your Mac
HA_URL=http://homeassistant.local:8123
# Profile → Security → Long-lived access tokens
HA_TOKEN=

# Which views of the default dashboard to snapshot into mock fixtures.
# eveus / deye are intentionally excluded for now.
SNAPSHOT_VIEWS=default_view

# Address of your Mac as seen from HA (for HMR inside the real HA sidebar: `pnpm dev:ha`)
DEV_HOST=antons-m4-air.local

# Where `pnpm deploy:ha` copies the integration.
# Samba share add-on mounted in Finder:  /Volumes/config
# or SSH add-on:                          root@homeassistant.local:/config
HA_CONFIG_TARGET=/Volumes/config
